// ── Epigraphs ──────────────────────────────────────────
#v(120pt)
#align(center)[
  #block(width: 74%)[
    #align(right)[
      #text(size: 11pt)[
        Man is a god when he dreams,\
        and a beggar when he reflects.
      ]
      #v(4pt)
      #text(size: 10pt)[Hölderlin]
    ]

    #v(40pt)

    #align(right)[
      #text(size: 11pt)[
        What God behind God begins the plot\
        of dust and time and dream and agonies?
      ]
      #v(4pt)
      #text(size: 10pt)[Borges]
    ]

    #v(40pt)

    #align(right)[
      #text(size: 11pt)[
        Man is the only creature on earth\
        that has the will to look into the interior of another.
      ]
      #v(4pt)
      #text(size: 10pt)[Hans Carossa]
    ]
  ]
]
